{
  "$schema": "https://claude.ai/schemas/hooks.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "tool == \"Bash\" && tool_input.command matches \"^gh pr create\"",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/post-pr-create.sh"
          }
        ],
        "description": "Suggest review after PR creation"
      }
    ]
  }
}
