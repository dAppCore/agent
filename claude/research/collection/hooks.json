{
  "version": "1.0.0",
  "hooks": {
    "on_url_found": [
      {
        "name": "whitepaper-collector",
        "pattern": "\\.pdf$",
        "handler": "./collect-whitepaper.sh",
        "priority": 10,
        "enabled": true
      },
      {
        "name": "whitepaper-iacr",
        "pattern": "eprint\\.iacr\\.org",
        "handler": "./collect-whitepaper.sh",
        "priority": 10,
        "enabled": true
      },
      {
        "name": "whitepaper-arxiv",
        "pattern": "arxiv\\.org",
        "handler": "./collect-whitepaper.sh",
        "priority": 10,
        "enabled": true
      }
    ],
    "on_file_collected": [
      {
        "name": "pdf-metadata",
        "pattern": "\\.pdf$",
        "handler": "./extract-pdf-metadata.sh",
        "priority": 5,
        "enabled": false
      }
    ],
    "on_collection_complete": [
      {
        "name": "update-index",
        "handler": "./update-index.sh",
        "priority": 100,
        "enabled": true
      }
    ]
  }
}
